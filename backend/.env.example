# Copy this file to ".env" and adjust the values.

# Server port
PORT=5000

# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/placement_prep_portal

# Secret used to sign JSON Web Tokens (change this in production)
JWT_SECRET=super_secret_change_me_please

# Token lifetime
JWT_EXPIRES_IN=7d

# Allowed frontend origin for CORS (the static frontend server)
CLIENT_ORIGIN=http://127.0.0.1:5500
